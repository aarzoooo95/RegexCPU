digraph DFA {
  rankdir=LR; labelloc=t; label="DFA (subset construction)";
  node [shape=circle, fontsize=11]; edge [fontsize=10];
  __s [shape=point];
  __s -> q0;
  q2 [shape=doublecircle];
  q3 [shape=doublecircle];
  q4 [shape=doublecircle];
  q0 -> q1 [label="a"];
  q0 -> q2 [label="c"];
  q1 -> q3 [label="b"];
  q2 -> q4 [label="d"];
}