digraph DFA {
  rankdir=LR; labelloc=t; label="Minimal complete DFA (red = dead states found by Tarjan)";
  node [shape=circle, fontsize=11]; edge [fontsize=10];
  __s [shape=point];
  __s -> q0;
  q2 [style=dashed, color=red, fontcolor=red];
  q3 [shape=doublecircle];
  q4 [shape=doublecircle];
  q0 -> q1 [label="a"];
  q0 -> q2 [label="b,d"];
  q0 -> q3 [label="c"];
  q1 -> q2 [label="a,c,d"];
  q1 -> q4 [label="b"];
  q2 -> q2 [label="a,b,c,d"];
  q3 -> q2 [label="a,b,c"];
  q3 -> q4 [label="d"];
  q4 -> q2 [label="a,b,c,d"];
}