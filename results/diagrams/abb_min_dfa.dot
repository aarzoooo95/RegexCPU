digraph DFA {
  rankdir=LR; labelloc=t; label="Minimal complete DFA (red = dead states found by Tarjan)";
  node [shape=circle, fontsize=11]; edge [fontsize=10];
  __s [shape=point];
  __s -> q0;
  q3 [shape=doublecircle];
  q0 -> q1 [label="a"];
  q0 -> q0 [label="b"];
  q1 -> q1 [label="a"];
  q1 -> q2 [label="b"];
  q2 -> q1 [label="a"];
  q2 -> q3 [label="b"];
  q3 -> q1 [label="a"];
  q3 -> q0 [label="b"];
}