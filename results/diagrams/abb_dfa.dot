digraph DFA {
  rankdir=LR; labelloc=t; label="DFA (subset construction)";
  node [shape=circle, fontsize=11]; edge [fontsize=10];
  __s [shape=point];
  __s -> q0;
  q4 [shape=doublecircle];
  q0 -> q1 [label="a"];
  q0 -> q2 [label="b"];
  q1 -> q1 [label="a"];
  q1 -> q3 [label="b"];
  q2 -> q1 [label="a"];
  q2 -> q2 [label="b"];
  q3 -> q1 [label="a"];
  q3 -> q4 [label="b"];
  q4 -> q1 [label="a"];
  q4 -> q2 [label="b"];
}